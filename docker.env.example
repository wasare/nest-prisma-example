# Modelo das variáveis do deploy com Docker Compose.
#
# Na raiz do projeto, copie para docker.env (que não vai para o Git nem para a imagem):
#   cp docker.env.example docker.env
# e suba o sistema com:
#   docker compose --env-file docker.env up -d --build
#
# Use uma senha só com letras e números: ela entra na URL de conexão.

POSTGRES_USER=nest
POSTGRES_PASSWORD=troqueEstaSenha123
POSTGRES_DB=nest_prisma

# Porta do computador onde a API fica acessível (http://localhost:APP_PORT)
APP_PORT=3000
